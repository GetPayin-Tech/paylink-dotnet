<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>Paylink.DependencyInjection</PackageId>
    <Version>0.1.0</Version>
    <Authors>GetPayIn</Authors>
    <Description>Dependency-injection integration for the Paylink SDK: services.AddPaylink(...) with IHttpClientFactory.</Description>
    <PackageTags>paylink;getpayin;payments;dependency-injection;aspnetcore</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GetPayin-Tech/paylink-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GetPayin-Tech/paylink-dotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Paylink/Paylink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
